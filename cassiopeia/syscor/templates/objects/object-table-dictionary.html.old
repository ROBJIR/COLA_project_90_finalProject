{% if var_dictionary %}
    <details>
        <summary class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-list-ul me-1"></i>
                {{ var_dictionary|length }}{% if var_label %}{{ var_label }}{% endif %}
        </summary>

        <div class="border text-sm-start rounded bg-body-tertiary p-2 mt-2 shadow">
            <table class="table table-sm mb-0">
                <tbody>
                    {% for key, value in var_dictionary.items %}
                        <tr>
                            <th scope="row" class="text-secondary small">
                                {{ key }}
                            </th>
                            <td class="text-break">
                                <strong>{{ value|default_if_none:"—" }}</strong>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </details>
{% else %}
    <span class="text-body-secondary">—</span>
{% endif %}